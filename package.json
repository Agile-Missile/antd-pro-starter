{
  "name": "antd-pro-starter",
  "version": "6.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "type": "module",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "npm run start:dev",
    "gh-pages": "gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "lint-fix": "yarn lint --fix",
    "lint-staged-files": "lint-staged --allow-empty",
    "openapi": "max openapi",
    "prepare": "husky install",
    "preview": "npm run build && max preview --port 8000",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env UMI_ENV=dev max dev",
    "start:dev": "cross-env REACT_APP_ENV=dev UMI_ENV=dev max dev",
    "start:no-mock": "cross-env MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "tsc": "tsc --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/plots": "^2.3.3",
    "@ant-design/pro-components": "^2.8.6",
    "@antv/l7": "^2.22.5",
    "@antv/l7-maps": "^2.22.5",
    "@antv/l7-react": "^2.4.3",
    "@dimjs/utils": "2.1.1",
    "@umijs/route-utils": "^4.0.1",
    "antd": "^5.24.4",
    "antd-style": "^3.7.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "numeral": "^2.0.6",
    "omit.js": "^2.0.2",
    "postcss": "8.5.3",
    "querystring": "^0.2.1",
    "rc-util": "^5.44.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-fittext": "^1.0.0",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@agilejs/typing-beautify": "1.0.7",
    "@ant-design/pro-cli": "^3.2.1",
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "@hyperse/eslint-config-hyperse": "^1.3.4",
    "@testing-library/react": "^16.2.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/classnames": "^2.3.4",
    "@types/express": "^5.0.0",
    "@types/history": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@types/react-helmet": "^6.1.11",
    "@umijs/fabric": "^4.0.1",
    "@umijs/max": "^4.4.6",
    "commitizen": "4.3.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^9.22.0",
    "express": "^4.21.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.0",
    "mockjs": "^1.1.0",
    "react-dev-inspector": "^2.0.1",
    "swagger-ui-dist": "^5.20.1",
    "tailwindcss": "^3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "umi-presets-pro": "^2.0.3"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "packageManager": "yarn@4.7.0"
}
